{
  "version": "1.4.2-i18n.1",
  "description": "Localized build of the Zed editor (cs-CZ)",
  "homepage": "https://github.com/LI-NA/zed-i18n",
  "license": "GPL-3.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.4.2-i18n.1/Zed-i18n-cs-CZ-windows-x86_64.zip",
      "hash": "2213b39c23ee0634aa18e85091e2ffe428fda9cbac05add9bd9d5e4aa0329322"
    },
    "arm64": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.4.2-i18n.1/Zed-i18n-cs-CZ-windows-aarch64.zip",
      "hash": "304367775c103ec6dc0c948cd178816448437f12d3ce822927f391da53d1cace"
    }
  },
  "bin": [
    [
      "bin\\zed.exe",
      "zed-i18n"
    ]
  ],
  "shortcuts": [
    [
      "Zed.exe",
      "Zed i18n (cs-CZ)"
    ]
  ],
  "env_set": {
    "ZED_UPDATE_EXPLANATION": "Run 'scoop update zed-i18n-cs-CZ' to update."
  },
  "post_install": [
    "$cfg = Join-Path $env:APPDATA 'Zed\\global_settings.json'",
    "$dir = Split-Path -Parent $cfg",
    "if (!(Test-Path $dir)) { New-Item -ItemType Directory -Path $dir | Out-Null }",
    "if ((Test-Path $cfg) -and ((Get-Item $cfg).Length -gt 0)) { $j = Get-Content $cfg -Raw | ConvertFrom-Json } else { $j = [pscustomobject]@{} }",
    "$j | Add-Member -MemberType NoteProperty -Name auto_update -Value $false -Force",
    "[System.IO.File]::WriteAllText($cfg, ($j | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding $false))"
  ],
  "checkver": {
    "url": "https://github.com/LI-NA/zed-i18n/releases/latest",
    "regex": "/releases/tag/v([\\d.]+-i18n\\.\\d+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-cs-CZ-windows-x86_64.zip"
      },
      "arm64": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-cs-CZ-windows-aarch64.zip"
      }
    },
    "hash": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/SHA256SUMS.txt"
    }
  }
}
