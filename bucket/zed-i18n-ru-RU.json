{
  "version": "1.4.4-i18n.1",
  "description": "Localized build of the Zed editor (ru-RU)",
  "homepage": "https://github.com/LI-NA/zed-i18n",
  "license": "GPL-3.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.4.4-i18n.1/Zed-i18n-ru-RU-windows-x86_64.zip",
      "hash": "1ee9ed7a37af73488ee7c5ae0accdb7ba2ccc8c19c7ffe184d26397e7d17d32a"
    },
    "arm64": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.4.4-i18n.1/Zed-i18n-ru-RU-windows-aarch64.zip",
      "hash": "2382d178c56413325bb31367dd89c3c5dfbb1abeb03d04c41823d64bd526d9d9"
    }
  },
  "bin": [
    [
      "bin\\zed.exe",
      "zed-i18n"
    ]
  ],
  "shortcuts": [
    [
      "Zed.exe",
      "Zed i18n (ru-RU)"
    ]
  ],
  "env_set": {
    "ZED_UPDATE_EXPLANATION": "Run 'scoop update zed-i18n-ru-RU' to update."
  },
  "post_install": [
    "$cfg = Join-Path $env:APPDATA 'Zed\\global_settings.json'",
    "$dir = Split-Path -Parent $cfg",
    "if (!(Test-Path $dir)) { New-Item -ItemType Directory -Path $dir | Out-Null }",
    "if ((Test-Path $cfg) -and ((Get-Item $cfg).Length -gt 0)) { $j = Get-Content $cfg -Raw | ConvertFrom-Json } else { $j = [pscustomobject]@{} }",
    "$j | Add-Member -MemberType NoteProperty -Name auto_update -Value $false -Force",
    "[System.IO.File]::WriteAllText($cfg, ($j | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding $false))"
  ],
  "checkver": {
    "url": "https://github.com/LI-NA/zed-i18n/releases/latest",
    "regex": "/releases/tag/v([\\d.]+-i18n\\.\\d+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-ru-RU-windows-x86_64.zip"
      },
      "arm64": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-ru-RU-windows-aarch64.zip"
      }
    },
    "hash": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/SHA256SUMS.txt"
    }
  }
}
