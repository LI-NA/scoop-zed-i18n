{
  "version": "1.13.1-i18n.1",
  "description": "Localized build of the Zed editor (pl-PL)",
  "homepage": "https://github.com/LI-NA/zed-i18n",
  "license": "GPL-3.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.13.1-i18n.1/Zed-i18n-pl-PL-windows-x86_64.zip",
      "hash": "62fe9cce549d670416817e3276642a1b5107dfd8c86c2e9bdc5c9fa7176f905e"
    },
    "arm64": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.13.1-i18n.1/Zed-i18n-pl-PL-windows-aarch64.zip",
      "hash": "ec6d5f3103c0a42ab724d7775490d2b4ea84fe0f753c00898ac5c53728b9032a"
    }
  },
  "bin": [
    [
      "bin\\zed.exe",
      "zed-i18n"
    ]
  ],
  "shortcuts": [
    [
      "Zed.exe",
      "Zed i18n (pl-PL)"
    ]
  ],
  "env_set": {
    "ZED_UPDATE_EXPLANATION": "Run 'scoop update zed-i18n-pl-PL' to update."
  },
  "post_install": [
    "$cfg = Join-Path $env:APPDATA 'Zed\\global_settings.json'",
    "$dir = Split-Path -Parent $cfg",
    "if (!(Test-Path $dir)) { New-Item -ItemType Directory -Path $dir | Out-Null }",
    "if ((Test-Path $cfg) -and ((Get-Item $cfg).Length -gt 0)) { $j = Get-Content $cfg -Raw | ConvertFrom-Json } else { $j = [pscustomobject]@{} }",
    "$j | Add-Member -MemberType NoteProperty -Name auto_update -Value $false -Force",
    "[System.IO.File]::WriteAllText($cfg, ($j | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding $false))"
  ],
  "checkver": {
    "url": "https://github.com/LI-NA/zed-i18n/releases/latest",
    "regex": "/releases/tag/v([\\d.]+-i18n\\.\\d+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-pl-PL-windows-x86_64.zip"
      },
      "arm64": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-pl-PL-windows-aarch64.zip"
      }
    },
    "hash": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/SHA256SUMS.txt"
    }
  }
}
