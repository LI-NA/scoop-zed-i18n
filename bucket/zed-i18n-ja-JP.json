{
  "version": "1.24.3-i18n.1",
  "description": "Localized build of the Zed editor (ja-JP)",
  "homepage": "https://github.com/LI-NA/zed-i18n",
  "license": "GPL-3.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.24.3-i18n.1/Zed-i18n-windows-x86_64.zip",
      "hash": "892109d6f465fd647aed9fc4c24d6475b8728bcb9579bfd0d9ed29a3413c28b9"
    },
    "arm64": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.24.3-i18n.1/Zed-i18n-windows-aarch64.zip",
      "hash": "9b902bdac449caf7309be6cd1a3d224d3a6575739b09e0e16ab12a69c2fe9424"
    }
  },
  "bin": [
    [
      "bin\\zed.exe",
      "zed-i18n"
    ]
  ],
  "shortcuts": [
    [
      "Zed.exe",
      "Zed i18n (ja-JP)"
    ]
  ],
  "env_set": {
    "ZED_UPDATE_EXPLANATION": "Run 'scoop update zed-i18n-ja-JP' to update."
  },
  "post_install": [
    "$cfg = Join-Path $env:APPDATA 'Zed\\global_settings.json'",
    "$dir = Split-Path -Parent $cfg",
    "if (!(Test-Path $dir)) { New-Item -ItemType Directory -Path $dir | Out-Null }",
    "if ((Test-Path $cfg) -and ((Get-Item $cfg).Length -gt 0)) { $j = Get-Content $cfg -Raw | ConvertFrom-Json } else { $j = [pscustomobject]@{} }",
    "$j | Add-Member -MemberType NoteProperty -Name auto_update -Value $false -Force",
    "[System.IO.File]::WriteAllText($cfg, ($j | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding $false))"
  ],
  "checkver": {
    "url": "https://github.com/LI-NA/zed-i18n/releases/latest",
    "regex": "/releases/tag/v([\\d.]+-i18n\\.\\d+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-windows-x86_64.zip"
      },
      "arm64": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-windows-aarch64.zip"
      }
    },
    "hash": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/SHA256SUMS.txt"
    }
  },
  "notes": [
    "zed-i18n now ships a single build with every language included,",
    "and this package installs that build. To switch to the plain",
    "package, run: scoop uninstall zed-i18n-ja-JP; scoop install zed-i18n"
  ]
}
