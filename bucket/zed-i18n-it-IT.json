{
  "version": "1.10.0-i18n.1",
  "description": "Localized build of the Zed editor (it-IT)",
  "homepage": "https://github.com/LI-NA/zed-i18n",
  "license": "GPL-3.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.10.0-i18n.1/Zed-i18n-it-IT-windows-x86_64.zip",
      "hash": "ca3a8b4e5405500f50af5b194d0cdf011af8bf3acd51cbeb15e300af46d12aa4"
    },
    "arm64": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v1.10.0-i18n.1/Zed-i18n-it-IT-windows-aarch64.zip",
      "hash": "2b7d892debdb7e07804abbccaa1da8ad8ec44786331668f429bacaec638c666a"
    }
  },
  "bin": [
    [
      "bin\\zed.exe",
      "zed-i18n"
    ]
  ],
  "shortcuts": [
    [
      "Zed.exe",
      "Zed i18n (it-IT)"
    ]
  ],
  "env_set": {
    "ZED_UPDATE_EXPLANATION": "Run 'scoop update zed-i18n-it-IT' to update."
  },
  "post_install": [
    "$cfg = Join-Path $env:APPDATA 'Zed\\global_settings.json'",
    "$dir = Split-Path -Parent $cfg",
    "if (!(Test-Path $dir)) { New-Item -ItemType Directory -Path $dir | Out-Null }",
    "if ((Test-Path $cfg) -and ((Get-Item $cfg).Length -gt 0)) { $j = Get-Content $cfg -Raw | ConvertFrom-Json } else { $j = [pscustomobject]@{} }",
    "$j | Add-Member -MemberType NoteProperty -Name auto_update -Value $false -Force",
    "[System.IO.File]::WriteAllText($cfg, ($j | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding $false))"
  ],
  "checkver": {
    "url": "https://github.com/LI-NA/zed-i18n/releases/latest",
    "regex": "/releases/tag/v([\\d.]+-i18n\\.\\d+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-it-IT-windows-x86_64.zip"
      },
      "arm64": {
        "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/Zed-i18n-it-IT-windows-aarch64.zip"
      }
    },
    "hash": {
      "url": "https://github.com/LI-NA/zed-i18n/releases/download/v$version/SHA256SUMS.txt"
    }
  }
}
